+KillEditorRow()
+{
+  if(menu_editor_lamp){ Destroy(menu_editor_lamp); menu_editor_lamp=0;}
+  if(menu_editor_text){ Destroy(menu_editor_text); menu_editor_text=0;}
+}
+EditorRowText()
+{
+  string back;
+  back=GetString("strings","MenuBackToEditor");
+  if(back=="") back="BACK TO THE EDITOR";
+  return back;
+}
+// the row with the lamp at x,y from the page's middle (X, Y set)
+EditorRowCreate(int x,int y,string back)
+{
+  menu_editor_x=x; menu_editor_y=y; menu_editor_w=16+strlen(back)*EDITOR_ROW_CHAR;
+  menu_editor_lamp=MenuCreate(472,0,X+x,Y+y,2230);
+  Action(menu_editor_lamp,act_menustandup,0,0);
+  menu_editor_text=PrintText(X+x+16,Y+y-6+2300,2300,back,2);
+}
+// the lines a page of the briefing takes: the file's lines, a long one as more
+EditorRowLines(string page)
+{
+  int f,n,k;
+  string s;
+  n=0;
+  f=FOpen(page);
+  while(!FEof(f))
+  {
+     s=FRead(f);
+     k=strlen(s);
+     if(k || !FEof(f)) n++;   // not the empty end after the last line's end
+     if(k>EDITOR_BRIEF_COLS) n=n+(k-1)/EDITOR_BRIEF_COLS;
+  }
+  FClose(f);
+  return n;
+}
+// the briefing's row: under a short page's text; else beside a title that leaves room; else at the bottom
+EditorRowOnBriefing(string page,string head)
+{
+  string back;
+  int x;
+  back=EditorRowText();
+  x=EDITOR_ROW_RIGHT-strlen(back)*EDITOR_ROW_CHAR-16;
+  if(EditorRowLines(page)<=EDITOR_ROW_LINES) EditorRowCreate(EDITOR_ROW_X,EDITOR_ROW_Y,back);
+  else if(BREIF_HEAD_X+strlen(head)*EDITOR_HEAD_CHAR+25<=x) EditorRowCreate(x,EDITOR_ROW_HEAD_Y,back);
+  else EditorRowCreate(x,EDITOR_ROW_LOW_Y,back);
+}
+// a click on the row (the lamp or its text)
+EditorRowClicked()
+{
+  int x,y;
+  if(!menu_editor_lamp || mclick!=1) return 0;
+  GetRCX(MAIN_X);GetRCY(MAIN_Y);
+  x=GetScreenInputX();
+  y=GetScreenInputY();
+  return x>=X+menu_editor_x-12 && x<X+menu_editor_x+menu_editor_w+4 && y>=Y+menu_editor_y-12 && y<Y+menu_editor_y+12;
 }
