+// The Esc menu of a map played from the editor (LocoFix's File > Play the map; src/LocoFix/restart.cpp,
+// the numbers are free in export.lgc): its exit page has BACK TO THE EDITOR, a row like the custom
+// maps page's - the lamp and the text -, which starts the game again in the editor on the map. While
+// the level runs inside the editor's own game (Run the level, PlayedFromEditor() 2) the row closes the
+// menu and the editor holds the level again.
+extern PlayedFromEditor() 202;
+extern BackToEditor() 203;
+int menu_editor_lamp=0,menu_editor_text=0,menu_editor_how=0,menu_editor_hold=0;
+#define EDITOR_ROW_X -150
+#define EDITOR_ROW_Y 80
 
