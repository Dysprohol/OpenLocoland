+KillEditorRow()
+{
+  if(menu_editor_lamp){ Destroy(menu_editor_lamp); menu_editor_lamp=0;}
+  if(menu_editor_text){ Destroy(menu_editor_text); menu_editor_text=0;}
+}
+// a click on the row (the lamp or its text) of the exit page
+EditorRowClicked()
+{
+  int x,y;
+  if(!menu_editor_lamp || mclick!=1) return 0;
+  GetRCX(MAIN_X);GetRCY(MAIN_Y);
+  x=GetScreenInputX();
+  y=GetScreenInputY();
+  return x>=X+EDITOR_ROW_X-12 && x<X+EDITOR_ROW_X+240 && y>=Y+EDITOR_ROW_Y-12 && y<Y+EDITOR_ROW_Y+12;
 }
