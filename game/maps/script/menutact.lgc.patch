+// The Esc menu of a map played from the editor (LocoFix's File > Play the map; src/LocoFix/restart.cpp,
+// the numbers are free in export.lgc): its first page (the briefing) and its exit page have BACK TO THE
+// EDITOR, a row like the custom maps page's - the lamp and the text -, which starts the game again in the
+// editor on the map. While the level runs inside the editor's own game (Run the level, PlayedFromEditor()
+// 2) the row closes the menu and the editor holds the level again.
+extern PlayedFromEditor() 202;
+extern BackToEditor() 203;
+int menu_editor_lamp=0,menu_editor_text=0,menu_editor_how=0,menu_editor_hold=0;
+int menu_editor_x=0,menu_editor_y=0,menu_editor_w=0;
+// the row's places, from the page's middle (MAIN_X, MAIN_Y; the lamp's middle): under the text as on the
+// exit page; on the briefing, when its page is longer than EDITOR_ROW_LINES lines, at the right of the
+// title's line (when the title leaves room) or else at the right of the text box's bottom
+#define EDITOR_ROW_X -150
+#define EDITOR_ROW_Y 80
+#define EDITOR_ROW_LINES 10
+#define EDITOR_ROW_RIGHT 178
+#define EDITOR_ROW_HEAD_Y -95
+#define EDITOR_ROW_LOW_Y 106
+#define EDITOR_ROW_CHAR 8
+#define EDITOR_HEAD_CHAR 18
+#define EDITOR_BRIEF_COLS 44
 
@@ -81,2 +103,60 @@
   Y=yyy-(SCR_DEF_Y-SCRY)/2;
