@@ -7,2 +7,18 @@
 
+// A custom map (CUSTOM_MAP) without the reinforcement (PLAYER_REINFORCEMENT 0) keeps a pirates' small
+// engine that stands on the map - its x and y (the ground under it, not the screen) within MapSizeX/Y;
+// one beyond the edge, where the authors' marks stand, is taken as ever
+#ifdef CUSTOM_MAP
+PirateEngineKept(int i)
+{
+  if( PLAYER_REINFORCEMENT>0 )
+    return 0;
+  return GetX(i)>=0 && GetX(i)<MapSizeX() && GetY(i)>=0 && GetY(i)<MapSizeY();
+}
+#else
+PirateEngineKept(int i)
+{
+  return 0;
+}
+#endif
 //инициализация, вызывается из InitDefault
