+KillCustomMenu()
+{
+  int j;
+  if(custommenu_created){
+    Genocide(472);
+    Genocide(CUSTOM_UP);
+    Genocide(CUSTOM_DOWN);
+    Genocide(CUSTOM_EDIT);
+    for(j=0;j<=CUSTOM_ROWS;j++)
+    {
+      if(custom_text[j]) Destroy(custom_text[j]);
+      custom_text[j]=0;
+    }
+  }
+  custommenu_created=0;
+}
+// the y of row j of the page: CUSTOM_EDITOR is the editor's, the others are map rows
+CustomMenuRowY(int j)
+{
+  if(j==CUSTOM_EDITOR) return CUSTOM_EDIT_Y;
+  return CUSTOM_Y+j*CUSTOM_DY;
+}
+// Reads the list: counts its maps (custom_count) and keeps the CUSTOM_ROWS of them from
+// custom_top on (custom_shown), keeping custom_top within the list.
+ReadCustomList()
+{
+  int file,pass,n;
+  string s,t;
+  for(pass=0;pass<2;pass++)
+  {
+    n=0;
+    custom_shown=0;
+    file=FOpen(CUSTOM_LIST);
+    while(file && !FEof(file))
+    {
+      s=FRead(file);
+      if(s!="")
+      {
+        t=FRead(file);
+        if(pass && n>=custom_top && custom_shown<CUSTOM_ROWS)
+        {
+          custom_folder[custom_shown]=s;
+          custom_title[custom_shown]=t;
+          custom_shown++;
+        }
+        n++;
+      }
+    }
+    FClose(file);
+    custom_count=n;
+    if(custom_top>custom_count-CUSTOM_ROWS) custom_top=custom_count-CUSTOM_ROWS;
+    if(custom_top<0) custom_top=0;
+  }
+}
+// A row: the glowing lamp of the in-game strategic map (it has no mouse tip, unlike the mission
+// dots, VID 468, whose tips name the missions) and the text.
+CustomMenuRowCreate(int j,string s)
+{
+  Action(MenuCreate(472,0,X+CUSTOM_X,Y+CustomMenuRowY(j),20),act_menustandup,0,0);
+  custom_text[j]=PrintText(X+CUSTOM_X+16,Y+CustomMenuRowY(j)-6+100,100,s,2);
+}
+CreateCustomMenu()
+{
+  int j;
+  string s;
+  if(custommenu_created) KillCustomMenu();
+  ReadCustomList();
+  GetRCX(MAIN_X);GetRCY(MAIN_Y);
+  s=GetString("strings","MenuCustomEditor");
+  if(s=="") s="MAP EDITOR";
+  CustomMenuRowCreate(CUSTOM_EDITOR,s);
+  for(j=0;j<custom_shown;j++)
+  {
+    CustomMenuRowCreate(j,custom_title[j]);
+    Action(MenuCreate(CUSTOM_EDIT,0,X+CUSTOM_EDIT_X,Y+CustomMenuRowY(j),20),act_menustandup,0,0);
+  }
+  if(custom_top>0)
+    MenuCreate(CUSTOM_UP,0,X+CUSTOM_ARROW_X,Y+CustomMenuRowY(0),20);
+  if(custom_top+custom_shown<custom_count)
+    MenuCreate(CUSTOM_DOWN,0,X+CUSTOM_ARROW_X,Y+CustomMenuRowY(CUSTOM_ROWS-1),20);
+  custommenu_created=1;
+}
+// Moves the list by n maps (up when negative) and shows it again.
+CustomMenuScroll(int n)
+{
+  int top;
+  top=custom_top;
+  custom_top=custom_top+n;
+  if(custom_top>custom_count-CUSTOM_ROWS) custom_top=custom_count-CUSTOM_ROWS;
+  if(custom_top<0) custom_top=0;
+  if(custom_top!=top)
+  {
+    PlaySFX(24);
+    CreateCustomMenu();
+  }
+}
+// The entry under the point (x, y) of the screen - a map row, CUSTOM_EDITOR or -1 for none.
+// The column of the edit icons and the scroll arrows is not a row (a click there is the icon's).
+CustomMenuEntryAt(int x,int y)
+{
+  int j,row_y;
+  GetRCX(MAIN_X);GetRCY(MAIN_Y);
+  if(x<X+CUSTOM_X-12 || x>X+CUSTOM_EDIT_X-12) return -1;
+  for(j=0;j<=CUSTOM_EDITOR;j++)
+    if(j<custom_shown || j==CUSTOM_EDITOR)
+    {
+      row_y=Y+CustomMenuRowY(j);
+      if(y>=row_y-CUSTOM_DY/2 && y<row_y+CUSTOM_DY/2) return j;
+    }
+  return -1;
+}
+// The map row whose edit icon is at the y of the screen, or -1.
+CustomMenuEditAt(int y)
+{
+  int j,row_y;
+  GetRCX(MAIN_X);GetRCY(MAIN_Y);
+  for(j=0;j<custom_shown;j++)
+  {
+    row_y=Y+CustomMenuRowY(j);
+    if(y>=row_y-CUSTOM_DY/2 && y<row_y+CUSTOM_DY/2) return j;
+  }
+  return -1;
+}
+// The map editor of the custom maps page - the one place the menu starts it from: its row on
+// the template, the edit icon of a map row on that map. LocoFix's StartEditorMode
+// (src/LocoFix/restart.cpp, extern number 200, free in export.lgc) starts the game again in its
+// editor mode, where the template opens as a new empty map.
+extern StartEditorMode(string map) 200;
+// LocoFix's GetMouseWheel (src/LocoFix/menu_input.cpp, extern number 201): the turn of the mouse
+// wheel in this frame, > 0 up - the list of the page scrolls with it.
+extern GetMouseWheel() 201;
+StartEditor(string map)
+{
+  ScrollLock(0);
+  StopMusic();
+  Effect(eff_fade,0);
+  StartEditorMode(map);
+}
+// Entry j of the custom maps page: a map row shows its map's briefing, whose start button loads
+// it like a campaign mission; CUSTOM_EDITOR is the editor; with `edit` (the edit icon of a map
+// row) the row's map opens in the editor. Returns 1 when the menu is left.
+CustomMenuSelect(int j,int edit)
+{
+  PlaySFX(24);
+  if(edit)
+  {
+    StartEditor("maps\\"+custom_folder[j]+"\\"+custom_folder[j]+".map");
+    return 1;
+  }
+  if(j==CUSTOM_EDITOR)
+  {
+    StartEditor("maps\\template\\template.map");
+    return 1;
+  }
+  active_map="maps\\"+custom_folder[j]+"\\"+custom_folder[j]+".map";
+  brief_list="maps\\"+custom_folder[j]+"\\brief.lst";
+  brief_title=custom_title[j];
+  curr_page=0;
+  KillCustomMenu();
+  SetMenuBriefState(-1);
+  return 0;
 }
